DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Create this connection string in MongoDB Atlas and never commit the real value.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/hos_trip_planner?retryWrites=true&w=majority
MONGO_DATABASE=hos_trip_planner
